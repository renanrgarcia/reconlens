# Postgres (api uses a libpq URL; worker uses an Npgsql connection string)
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Matching
MATCH_THRESHOLD=0.80

# Azure OpenAI (optional; without it the offline local-hash-v1 embedder is used)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Worker
API_BASE_URL=http://localhost:8000
SALES_SOURCE=csv
SALES_CSV_PATH=data/sales.csv
SCHEDULE_SECONDS=300
# Worker with SALES_SOURCE=databricks
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
